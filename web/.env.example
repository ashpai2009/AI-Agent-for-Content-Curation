# Where the council service is listening.
#
# Local development, with the service running on this machine:
#   COUNCIL_API_URL=http://127.0.0.1:8000
#
# Deployed on Vercel: the address of the machine running the service, reachable from the
# internet. A tunnel is the usual answer -- `cloudflared tunnel --url http://localhost:8000`
# prints one. The council itself CANNOT run on Vercel: it shells out to the Claude Code CLI
# under your subscription login, keeps SQLite on a writable filesystem, and runs jobs for
# minutes. See README.md.
COUNCIL_API_URL=http://127.0.0.1:8000

# The service's API_TOKEN, if it has one set. Read only on the server -- it is never sent
# to the browser, which is why the page talks to /api/* here instead of to the service.
#
# Set API_TOKEN on the service and this to match whenever the service is reachable from
# anywhere but localhost. A tunnel is the whole internet.
COUNCIL_API_TOKEN=
