# --- Curator data must never be committed -----------------------------------
# Real workbooks, instruction documents, extracted text, and anything the
# pipeline produces from them stay strictly local. Fixtures used by the test
# suite are generated at runtime into tmp_path, never checked in.
recon/
jobs/
outputs/
*.xlsx
*.xls
*.pdf
*.docx
*.db
*.db-wal
*.db-shm
