# Copy to .env and fill in. .env is gitignored.

# --- Model backend ----------------------------------------------------------
# The Claude Code CLI, running on your Claude subscription. There is NO API key:
# the CLI authenticates through its own login (`claude auth login`), and this
# service refuses to start on an API credential so a subscription can never be
# silently converted into metered billing.
#
# The names are prefixed COUNCIL_ deliberately. `CLAUDE_EFFORT` is a variable the
# Claude Code CLI itself sets, so an unprefixed setting would be overridden by
# whatever session happened to launch the service.
COUNCIL_CLAUDE_CLI_PATH=claude
COUNCIL_CLAUDE_MODEL=sonnet
# low | medium | high | xhigh | max. Lowering this is a quality change, not a
# cost trim: the auditor and reviewers judge mathematics, and missed defects
# produce more repair rounds.
COUNCIL_CLAUDE_EFFORT=medium
# Optional per-agent overrides. Leave commented until a labelled A/B run proves that
# the extra reasoning improves exact corrections enough to justify the allowance.
# COUNCIL_INITIAL_AUDITOR_EFFORT=high
# COUNCIL_WRITER_EFFORT=high
# COUNCIL_KNOWN_ISSUE_REVIEWER_EFFORT=high
# COUNCIL_INDEPENDENT_REVIEWER_EFFORT=high
# Hard ceiling on agentic turns in each print-mode invocation. Two is the measured
# minimum that reliably allows schema-constrained output to be emitted.
COUNCIL_CLAUDE_MAX_TURNS=4
# Per model call. A call with no ceiling is a worker that can hang for the life
# of the process while holding a lease.
PROVIDER_TIMEOUT_SECONDS=300
# Attempts per call including the first, for failures that retrying can fix: a
# 429, a 5xx, a timeout. A rejected key or an unknown model is never retried.
PROVIDER_MAX_ATTEMPTS=4
# Ceiling on any single backoff, including a Retry-After the server asked for.
PROVIDER_BACKOFF_CEILING_SECONDS=60
# Model calls a job may lose to provider failure before the job fails as
# `provider`. Counted from durable events, so it survives a crashed worker.
PROVIDER_FAILURE_BUDGET=12

# --- Council behaviour ------------------------------------------------------
# Writer/reviewer repair attempts per issue before the issue is escalated to a
# human. One attempt == one Writer LLM call.
MAX_REPAIR_ATTEMPTS=3
# How many times final validation may hand repairable findings back to the
# council before it reports them instead of repairing them.
MAX_VALIDATION_ROUNDS=2
# Global fuses. Exceeding either fails the job rather than letting it spin.
STEP_BUDGET=2000
LLM_CALL_BUDGET=1500
# Attempts refunded when one is lost to infrastructure (a timeout, a provider
# 500, a killed worker) rather than to the Writer getting it wrong. Bounded, so
# neither counter can loop.
INTERRUPTED_RETRY_BUDGET=2
# How long a worker's claim on a job survives without a heartbeat. A job whose
# lease expires becomes claimable again, which is how a crash resumes itself.
LEASE_SECONDS=120
# The renewal interval is LEASE_SECONDS / HEARTBEAT_DIVISOR, derived rather than
# configured separately: two numbers where one must stay under the other is a
# mistake waiting to be made in an incident.
HEARTBEAT_DIVISOR=4
# How often the poller looks for jobs whose worker died. This is what makes the
# `jobs` table a queue rather than a log.
POLL_INTERVAL_SECONDS=15
# Wall-clock ceiling for one worker's run of a job. Bounds a worker that is
# alive, within budget, and simply getting nowhere. 0 disables it.
RUN_DEADLINE_SECONDS=21600
# --- Access -----------------------------------------------------------------
# Shared bearer token for every endpoint except /health. Empty means the service
# is open, which is only safe behind a proxy that authenticates for it -- the
# process logs a warning at startup and /readyz reports which it is.
API_TOKEN=

# --- Storage ----------------------------------------------------------------
# Root for per-job directories and the SQLite state database.
DATA_ROOT=./jobs
# Concurrent jobs in-process. SQLite is single-writer, and the CLI backend runs
# against one interactive subscription -- two jobs in parallel double the rate a
# session allowance is spent and make a usage limit twice as likely mid-run.
MAX_CONCURRENT_JOBS=1
# How long a finished job's files and rows are kept before the poller deletes
# them. 0 keeps everything forever -- a decision worth making deliberately for a
# service holding other people's course material.
RETENTION_DAYS=30

# --- Scanning ---------------------------------------------------------------
# How many problem blocks one Initial Auditor or Independent Reviewer call
# examines. 1 delegates to the unchanged single-block path, so it is a genuine
# no-op; raise it only after comparing runs on labelled material. Range 1-16.
SCAN_BATCH_SIZE=2
REPAIR_BATCH_SIZE=8
# Ceiling on a batch's total rendered contribution -- blocks, applicable claims,
# deterministic findings and labels together. At least one block is always
# admitted even if it exceeds this alone, or the phase would requeue it forever.
SCAN_BATCH_MAX_CHARACTERS=24000

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_BYTES=52428800
